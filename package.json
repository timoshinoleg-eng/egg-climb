{
  "name": "egg-climb",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:sim": "node scripts/check-sim-determinism.mjs",
    "test": "npm run build && npm run check:sim && node --test test/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "debug:serve": "npm run build && node scripts/serve-debug.mjs",
    "package:playtest": "npm run build && node scripts/package-playtest.mjs",
    "replay:playtest": "npm run build && node scripts/replay-playtest.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.20.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "fast-check": "4.9.0",
    "typescript": "5.9.3"
  }
}
